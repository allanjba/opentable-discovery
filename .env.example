# Algolia credentials. Copy to .env and fill in from the Algolia dashboard
# (Settings → API Keys). .env is gitignored; this file is the template.

# Server-side only — used by the scripts in scripts/.
APPLICATION_ID=
SEARCH_API_KEY=
WRITE_API_KEY=

# Browser-side — Next only exposes variables prefixed NEXT_PUBLIC_ to the client.
# Same values as APPLICATION_ID and SEARCH_API_KEY above.
#
# The search key is read-only and public by design; it ships in the JS bundle of
# every Algolia-powered site. The WRITE key must never get a NEXT_PUBLIC_ prefix.
#
# These two must also be set in the Vercel project's Environment Variables, or
# the production build fails.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
